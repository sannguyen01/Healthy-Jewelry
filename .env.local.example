# Healthy Jewelry — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── Shopify Storefront API ─────────────────────────────────────────────────
# Public domain — used by both server components and the client proxy
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API token — server-side only (avoid NEXT_PUBLIC_ to prevent
# accidental bundle inclusion; the /api/shopify proxy injects it server-side)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# ── Shopify Webhooks ───────────────────────────────────────────────────────
# Signing secret from Shopify Admin → Settings → Notifications → Webhooks
SHOPIFY_WEBHOOK_SECRET=your-webhook-signing-secret
SHOPIFY_REVALIDATION_SECRET=your-revalidation-secret

# ── OPTIONAL — Admin API ───────────────────────────────────────────────────
# Reserved for future Order Management / inventory features.
# Do NOT generate or set this unless Admin API consumers are built.
# SHOPIFY_ADMIN_ACCESS_TOKEN=your-admin-token

# ── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://healthyjewellery.com

# ── Verification scripts (not read by the app) ─────────────────────────────
# The store domain under a second name. The app can only use the NEXT_PUBLIC_
# one above — Next inlines it at build time — while CI, both GitHub workflows
# and the verification scripts use this one. `resolveStoreDomain()` in
# scripts/lib/webhook-signature.mjs accepts either, so setting one is enough;
# both are documented because both appear in real configuration.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API token. Optional in normal operation — the storefront never needs
# it. `scripts/verify-production.mjs` uses it for a single publication-count
# query, so grant read scopes only.
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx
