# ── Shopify Storefront API ─────────────────────────────────────────────────────
# Your Shopify store's myshopify.com domain (no https://)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token (from Shopify Admin → Apps → Custom Apps)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token_here

# Public version of the store domain (accessible in browser)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# ── Shopify Webhooks ───────────────────────────────────────────────────────────
# Signing secret from Shopify Admin → Settings → Notifications → Webhooks
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ── Site ──────────────────────────────────────────────────────────────────────
# Production URL (used for canonical tags, OG URLs, and sitemap)
NEXT_PUBLIC_SITE_URL=https://healthyjewelry.vn
