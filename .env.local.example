# Healthy Jewelry — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── Shopify Storefront API ─────────────────────────────────────────────────
# Your Shopify store domain (e.g. your-store.myshopify.com)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token (public — safe to expose in the browser)
# Create at: Shopify Admin → Apps → Develop apps → your app → Storefront API
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Admin API access token (private — server-side only, never NEXT_PUBLIC_)
SHOPIFY_ADMIN_ACCESS_TOKEN=your-admin-token

# Webhook revalidation secret — used to verify Shopify webhook payloads
SHOPIFY_REVALIDATION_SECRET=your-webhook-secret

# ── Site ───────────────────────────────────────────────────────────────────
# Public-facing site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://healthyjewelry.com
