# Healthy Jewelry — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── Retained until WS-F deletes the webhook subscriptions ──────────────────
# Nothing on this site can be bought, and these are the last commerce variables any code
# reads: /api/webhooks/shopify verifies deliveries with the signing secret and compares the
# store domain. They leave with that route. The storefront token, the revalidation secret,
# the customer-account trio and the Admin token were removed on 2026-09-26 with their last
# readers — see docs/runbooks/ws-d-vercel-env.md for removing them from Vercel too.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_WEBHOOK_SECRET=your-webhook-signing-secret

# ── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://healthyjewellery.com
# RATE_LIMIT_KEY_SECRET=  (optional) 32+ chars, e.g. `openssl rand -base64 48`; HMAC key that pseudonymises client IPs in rate-limit buckets. Unset: unkeyed SHA-256, reported by /api/health as ipKeying.

# ── Verification scripts (not read by the app) ─────────────────────────────
# The store domain under a second name. The app can only use the NEXT_PUBLIC_
# one above — Next inlines it at build time — while CI, both GitHub workflows
# and the verification scripts use this one. `resolveStoreDomain()` in
# scripts/lib/webhook-signature.mjs accepts either, so setting one is enough;
# both are documented because both appear in real configuration.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Optional, read by `scripts/probe-canonical-domain.mjs` only. When set to a commit
# SHA — in CI, `main`'s tip — the probe additionally checks that the deployment the
# brand domain serves is built from that commit, so "production is pinned to an older
# deployment" is reported instead of passing as merely reachable. Unset, the probe still
# checks everything else and simply does not make that comparison.
EXPECTED_COMMIT=
